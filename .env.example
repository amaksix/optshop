# Public site URL used in canonical links. Also update public/sitemap.xml,
# public/robots.txt and public/llms.txt if this domain changes.
VITE_SITE_URL=https://stockmondo.eu

# Optional. POST JSON to this URL when the contact form is submitted.
VITE_CONTACT_ENDPOINT=

# Optional. Opens the visitor's email app addressed to this inbox.
VITE_CONTACT_EMAIL=
